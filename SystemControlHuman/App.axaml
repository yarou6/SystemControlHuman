<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:internal="clr-namespace:Microsoft.EntityFrameworkCore.Metadata.Internal;assembly=Microsoft.EntityFrameworkCore"
             x:Class="SystemControlHuman.App">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        
        <Style Selector="Window">
            <Setter Property="Background" Value="#1a1208" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#FFD700" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#1c1208" />
            <Setter Property="Foreground" Value="#FFD700" />
            <Setter Property="BorderBrush" Value="#C9A227" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#2a1a0f" />
            <Setter Property="Foreground" Value="#FFD700" />
            <Setter Property="BorderBrush" Value="#C9A227" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#4a2f14" />
            <Setter Property="Effect">
                <DropShadowEffect BlurRadius="15" Color="#FFD700" Opacity="0.8" />
            </Setter>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#1a0f07" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#1c1208" />
            <Setter Property="Foreground" Value="#FFD700" />
            <Setter Property="BorderBrush" Value="#C9A227" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="#1c1208"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#C9A227"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="#1a1208"/>
        </Style>

        <Style Selector="DataGridRow:nth-child(even)">
            <Setter Property="Background" Value="#22160c"/>
        </Style>

        <Style Selector="TabControl">
            <Setter Property="Background" Value="#1a1208" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="#FFD700" />
        </Style>
        
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#FFD700"/> 
            <Setter Property="Background" Value="#1c1208"/> 
            <Setter Property="BorderBrush" Value="#C9A227"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <Path x:Name="checkMark"
                                  Data="M 0 4 L 3 7 L 8 0"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{TemplateBinding IsChecked}" />
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center"
                                              Margin="6,0,0,0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="CheckBox:pointerover">
            <Setter Property="Background" Value="#4a2f14"/>
            <Setter Property="Effect">
                <DropShadowEffect BlurRadius="10" Color="#FFD700" Opacity="0.5"/>
            </Setter>
        </Style>

        <Style Selector="CheckBox:pressed">
            <Setter Property="Background" Value="#1a0f07"/>
        </Style>
    </Application.Styles>



</Application>